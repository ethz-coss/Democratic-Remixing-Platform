# Local simulation environment variables
# Copy to simulations/.env and fill values as needed.

# Local settings
LOCAL_POCKETBASE_URL=http://localhost:8090
LOCAL_PB_SUPERUSER_EMAIL=example@mail.ch
LOCAL_PB_SUPERUSER_PASSWORD=test_pw

# Production settings (only used if --env prod is passed)
PROD_POCKETBASE_URL=https://collective-intelligence.ethz.ch
PROD_PB_SUPERUSER_EMAIL=example@mail.ch
PROD_PB_SUPERUSER_PASSWORD=test_pw2

# Optional LLM auth (if not using --disable-llm)
SIM_LLM_API_KEY=
GITHUB_TOKEN=
GH_MODELS_TOKEN=


