{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:debug:api": "PRIVATE_API_DEBUG_LOGS=true PUBLIC_API_DEBUG_LOGS=true npm run dev",
		"dev:debug:api:body": "PRIVATE_API_DEBUG_LOGS=true PRIVATE_API_DEBUG_LOGS_BODY=true PUBLIC_API_DEBUG_LOGS=true PUBLIC_API_DEBUG_LOGS_BODY=true npm run dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/d3": "^7.4.3",
		"@types/diff": "^7.0.2",
		"@types/node": "^22",
		"@types/web-push": "^3.6.4",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"mdsvex": "^0.12.6",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"@dagrejs/dagre": "^3.0.0",
		"@inlang/paraglide-js": "^2.18.2",
		"@lucide/svelte": "^1.21.0",
		"@tiptap/core": "^3.20.2",
		"@tiptap/extension-placeholder": "^3.20.2",
		"@tiptap/pm": "^3.20.2",
		"@tiptap/starter-kit": "^3.20.2",
		"@yeger/html-diff": "^1.0.3",
		"d3": "^7.9.0",
		"diff": "^8.0.3",
		"eventsource": "^4.1.0",
		"fuse.js": "^7.4.2",
		"pocketbase": "^0.27.0",
		"svelte-dnd-action": "^0.9.70",
		"vaul-svelte": "^0.3.2",
		"web-push": "^3.6.7"
	},
	"overrides": {
		"svelte": "^5.51.0"
	}
}
