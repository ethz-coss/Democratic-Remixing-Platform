# Browser-side PocketBase URL
PUBLIC_POCKETBASE_URL="http://localhost:18090"

# Server-side PocketBase URL (Docker internal network)
PRIVATE_POCKETBASE_URL="http://pocketbase:8090"

# API interface debug logs (set true/1/on/yes)
PUBLIC_API_DEBUG_LOGS="false"
PUBLIC_API_DEBUG_LOGS_BODY="false"
PRIVATE_API_DEBUG_LOGS="false"
PRIVATE_API_DEBUG_LOGS_BODY="false"

# Optional existing app variables
ORIGIN=""

# Push Notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
PUSH_SECRET="dev-secret-123"

# Simulation LLM (If you want to run simulations from the web UI)
PRIVATE_SIM_LLM_API_KEY=""
PRIVATE_SIM_LLM_MODEL="openai/gpt-4.1-mini"
# PRIVATE_SIM_LLM_BASE_URL="https://models.github.ai/inference"
