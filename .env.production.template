# =============================================================================
# Production Environment
# =============================================================================
# Copy this file to .env.production and adjust values for your deployment.
# .env.production is gitignored — do NOT commit secrets.

# --- PocketBase URLs ---
# Browser-side: the public URL users see (routed through Nginx/Caddy)
PUBLIC_POCKETBASE_URL=/

# Public site URL used as the canonical source for browser-facing addresses
ORIGIN=https://your-domain.example.com

# Server-side: internal container network (SvelteKit SSR → PocketBase)
PRIVATE_POCKETBASE_URL=http://pocketbase:8090

# --- SvelteKit ---
NODE_ENV=production

# Max request body size (10 MB)
BODY_SIZE_LIMIT=10485760

# --- Debug (disable in production) ---
PUBLIC_API_DEBUG_LOGS=false
PUBLIC_API_DEBUG_LOGS_BODY=false
PRIVATE_API_DEBUG_LOGS=false
PRIVATE_API_DEBUG_LOGS_BODY=false

# --- Push Notifications ---
# Generate VAPID keys once with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY is also served to browsers via GET /api/push-subscribe
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:example@email.ch"
# PUSH_SECRET must be a strong random string shared between PocketBase (FRONTEND_URL caller)
# and SvelteKit (/api/push-send authenticator). Generate with: openssl rand -hex 32
PUSH_SECRET=""

# --- Simulation LLM (If you want to run simulations from the web UI) ---
PRIVATE_SIM_LLM_API_KEY=""
PRIVATE_SIM_LLM_MODEL=""
