{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": false,
    "moduleDetection": "force",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "./src/hooks",
    "types": []
  },
  "include": ["src/hooks/**/*", "pb_data/types.d.ts"],
  "exclude": ["node_modules"]
}
